{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.86",
        "--browser",
        "chrome",
        "--user-data-dir",
        ".playwright-mcp/profile",
        "--output-dir",
        ".playwright-mcp/output",
        "--viewport-size",
        "1280x800"
      ]
    }
  }
}

# 로컬 개발 환경 값
# 이 파일을 .env로 복사해서 쓴다. .env는 Git에 올리지 않는다.
# 여기 적힌 값은 로컬 전용이다. 실제 서버의 비밀번호를 적지 않는다.

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=itting
MYSQL_USER=itting
MYSQL_PASSWORD=itting
# 내 PC에 MySQL이 이미 3306으로 떠 있으면 3307처럼 다른 번호로 바꾼다.
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379

# Mailpit(메일 받아 보기). 받은 메일은 http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Mattermost Incoming Webhook URL(SSAFY 인증 코드 DM). 기수마다 그 기수 서버의 팀원 계정으로 만든다.
# 쉼표로 여러 개를 넣으면 돌아가며 쓰고, 실패하면 다음 것으로 보낸다. URL은 비밀값이니 공유하지 않는다.
MATTERMOST_WEBHOOK_URLS_15=
MATTERMOST_WEBHOOK_URLS_16=

# 브라우저 푸시(VAPID) 키. backend/에서 ./gradlew -q vapidKeys를 실행하면 아래 두 줄이 나온다. 그대로 붙여 넣는다.
# 개인 키는 비밀값이니 공유하지 않는다. 하나라도 비워 두면 서버는 뜨지만 푸시는 보내지 않는다.
ITTING_PUSH_PUBLIC_KEY=
ITTING_PUSH_PRIVATE_KEY=
# 푸시 서비스가 문제를 알릴 때 연락할 곳. mailto:<팀 이메일 주소> 형식으로 적는다.
ITTING_PUSH_SUBJECT=

# Google 로그인 · 연동(OAuth 클라이언트). Google Cloud 콘솔에서 "웹 애플리케이션" 클라이언트를 만들어 값을 넣는다.
# "승인된 리디렉션 URI"에 아래 ITTING_GOOGLE_REDIRECT_URI와 같은 주소를 등록한다.
# 클라이언트 보안 비밀은 비밀값이니 공유하지 않는다. 비워 두면 서버는 뜨지만 Google 로그인 · 연동은 실패한다.
ITTING_GOOGLE_CLIENT_ID=
ITTING_GOOGLE_CLIENT_SECRET=
ITTING_GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/oauth/google/callback

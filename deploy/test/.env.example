# 테스트 서버 값. 서버의 /opt/it-ting/test/.env로 복사해 채운다. .env는 Git에 올리지 않는다.
# 이 파일(.env.example)에는 값을 적지 않는다. 채우는 순서는 docs/infra/test-server.md.

# 주소. DNS A 레코드가 이 서버의 고정 IP를 가리켜야 한다. https:// 없이 이름만 적는다.
# 예: TEST_HOST=test.example.com, TEST_MAIL_HOST=mail-test.example.com
TEST_HOST=
TEST_MAIL_HOST=

# MySQL. 비밀번호 둘은 서버에서 무작위로 만든다: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=itting
MYSQL_USER=itting
MYSQL_PASSWORD=

# 받은 메일 화면(Mailpit)의 로그인. "아이디:비밀번호" 형식으로 적는다.
MAILPIT_UI_AUTH=

# Mattermost Incoming Webhook URL(SSAFY 인증 코드 DM). 기수마다 그 기수 서버의 팀원 계정으로 만든다.
# 쉼표로 여러 개를 넣으면 돌아가며 쓴다. 비워 두면 그 기수는 SSAFY 인증이 503이라 가입을 끝낼 수 없다.
MATTERMOST_WEBHOOK_URLS_15=
MATTERMOST_WEBHOOK_URLS_16=

# (선택) 브라우저 푸시 키. 내 PC의 backend/에서 ./gradlew -q vapidKeys로 만든다. 비우면 푸시만 보내지 않는다.
ITTING_PUSH_PUBLIC_KEY=
ITTING_PUSH_PRIVATE_KEY=
ITTING_PUSH_SUBJECT=

# (선택) Google 로그인 · 연동. 비우면 Google 로그인만 실패한다.
# Google Cloud 콘솔의 "승인된 리디렉션 URI"에 https://<TEST_HOST>/api/v1/oauth/google/callback 을 더한다.
ITTING_GOOGLE_CLIENT_ID=
ITTING_GOOGLE_CLIENT_SECRET=

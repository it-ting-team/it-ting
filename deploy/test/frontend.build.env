# 실제(테스트) 서버용 프론트엔드 빌드 값. frontend/Dockerfile이 .env.production.local로 넣는다.
# 빌드할 때 JS에 박혀 누구나 볼 수 있다. 비밀값을 넣지 않는다. 이름의 뜻은 frontend/.env.example.

# 모든 영역을 실제 백엔드로 부른다.
NEXT_PUBLIC_API_MODE=real
# 실제 모드여도 목으로 둘 영역. 없다. 실시간 소식(SSE, 영역 이름 events)도 실제 백엔드에 연결한다.
NEXT_PUBLIC_API_MOCK_AREAS=
# 같은 주소의 /api/v1을 부른다. 앞단 Caddy가 백엔드로 넘기므로 Next의 /api 프록시는 끈다.
NEXT_PUBLIC_API_BASE=/api/v1
API_PROXY_TARGET=off
# 실험실은 끈다.
NEXT_PUBLIC_LABS=0

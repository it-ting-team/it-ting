# 목 사이트(Vercel)용 프론트엔드 빌드 값. deploy-mock.yml이 frontend/.env.production.local로 넣는다.
# 빌드할 때 JS에 박혀 누구나 볼 수 있다. 비밀값을 넣지 않는다. 이름의 뜻은 frontend/.env.example.

# 모든 영역을 목 서버(브라우저 안)로 돌린다. 백엔드가 없으므로 /api 프록시는 끈다.
NEXT_PUBLIC_API_MODE=mock
API_PROXY_TARGET=off
# 실험실을 켠다. 목 서버 손잡이 배지로 느림 · 실패 · 빈 목록을 확인한다.
NEXT_PUBLIC_LABS=1
